<Window x:Class="CrevecoeurArnaud_WPF_Agencement_Exercice1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrevecoeurArnaud_WPF_Agencement_Exercice1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Background="Yellow">
            <Button Height="100">Hello</Button>
            <Button Height="100">Hi</Button>
        </StackPanel>
        <DockPanel  Grid.Column="1">
            <Button DockPanel.Dock="Top" Height="50">Top</Button>
            <Button DockPanel.Dock="Bottom" Height="50">Bottom</Button>
            <Button DockPanel.Dock="Left">Left</Button>
            <Button DockPanel.Dock="Right">Right</Button>
            <Button>Center</Button>
        </DockPanel>
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Green">
            <Button Width="95">Hello</Button>
            <Button Width="95">Hi</Button>
            <Button Width="95">Help</Button>
            <Button Width="95" Height="50">Goodbye</Button>
            <Button Width="95">ILY</Button>
            <Button Width="95">Haaaa</Button>
        </WrapPanel>
        <Canvas Grid.Column="1" Grid.Row="1" Background="Coral">
            <Ellipse Fill="Black" Height="150" Canvas.Left="75" Canvas.Top="25" Width="150"/>
            <Ellipse Fill="Yellow" Height="100" Canvas.Left="100" Canvas.Top="50" Width="100"/>
            <Ellipse Fill="Red" Height="50" Canvas.Left="125" Canvas.Top="75" Width="50"/>
        </Canvas>
    </Grid>
</Window>
